# macOS / 系统垃圾
.DS_Store
._*
Icon?

# Obsidian 运行时状态（每次开关都变，不必版本化）
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/plugins/*/data.json.bak-*
.obsidian/plugins/*/main.js.map
.trash/

# 脚本缓存
__pycache__/
*.pyc

# 社区插件本体不进仓库（克隆后用 scripts/obsidian-connect.sh 或 OpenPlug 现场安装）
.obsidian/plugins/

# Copilot 插件的本地缓存 / 索引
.copilot/
